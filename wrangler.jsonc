{
  "name": "personal-dashboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "GOOGLE_OAUTH_PUBLISHING_STATUS": "testing" },
  "triggers": { "crons": ["0 * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "DASHBOARD", "class_name": "Dashboard" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Dashboard"] }],
}
