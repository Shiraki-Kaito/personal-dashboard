{
  "display_information": {
    "name": "personal-dashboard",
    "description": "本人専用ダッシュボードの指定チャンネル閲覧",
    "background_color": "#141a24"
  },
  "features": {
    "bot_user": { "display_name": "personal-dashboard", "always_online": false }
